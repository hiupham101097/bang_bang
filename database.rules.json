{
  "rules": {
    "voiceRooms": {
      "$sessionId": {
        ".read": "auth != null && root.child('voiceAccess').child($sessionId).child(auth.uid).child('expiresAt').val() > now",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('voiceAccess').child($sessionId).child(auth.uid).child('expiresAt').val() > now"
          }
        },
        "signals": {
          "$recipient": {
            ".read": "auth != null && auth.uid === $recipient && root.child('voiceAccess').child($sessionId).child(auth.uid).child('expiresAt').val() > now",
            "$signalId": {
              ".write": "auth != null && root.child('voiceAccess').child($sessionId).child(auth.uid).child('expiresAt').val() > now && ((newData.exists() && newData.child('from').val() === auth.uid) || (!newData.exists() && auth.uid === $recipient))"
            }
          }
        }
      }
    },
    "voiceAccess": { ".read": false, ".write": false },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['displayName', 'avatarAsset', 'createdAt', 'updatedAt'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "avatarAsset": {
            ".validate": "newData.isString() && newData.val().beginsWith('assets/images/')"
          },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "wallet": { ".write": false },
        "titles": { ".write": false },
        "equippedTitle": { ".write": false }
      }
    }
  }
}
